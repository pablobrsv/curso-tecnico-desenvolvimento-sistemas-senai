programa 
{
    funcao inicio() 
    {
        inteiro num1, num2
        
        escreva("Primeiro N: ")
        leia(num1)
        
        escreva("Segundo N: ")
        leia(num2)
        
        soma(num1, num2)
    }
    
    funcao soma(inteiro a, inteiro b) 
    {
        escreva("Soma: ", a + b)
    }
}
