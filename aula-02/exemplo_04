public class ExemploRepeticao4 {
    public static void main(String[] args) {
        // Faça um programa que percorra todos os nºs de 1 até 26. Para os nºs múltiplos de 2 imprima a palavra "JAVA"
        
        for (int i = 1; i <= 26; i++) {
            // Verifica se o número é múltiplo de 2 (ou seja, se é par)
            if (i % 2 == 0) {
                System.out.println(i + " - JAVA");
            } else {
                System.out.println(i);
            }
        }
    }
}
